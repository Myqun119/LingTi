<view class="grid">
  <view class="grid-item" wx:for="{{items}}" wx:key="key" data-index="{{index}}" bindtap="handleTap">
    <view class="icon" style="background: {{item.color}}22; color: {{item.color}};">
      {{item.icon}}
    </view>
    <view class="content">
      <view class="title">{{item.title}}</view>
      <view class="desc">{{item.desc}}</view>
    </view>
  </view>
</view>