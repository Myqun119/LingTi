<view class="page">
  <view class="card">
    <view class="section-title">
      <text>{{detail.title}}</text>
      <text class="primary">{{detail.status}}</text>
    </view>
    <view class="muted">时间：{{detail.time}}</view>
    <view class="muted">地点：{{detail.venue}}</view>
    <view class="muted">费用：{{detail.fee}}</view>
    <view class="muted">名额：{{detail.quota}}</view>
    <view class="section">
      <text class="muted">报名规则</text>
      <view>{{detail.rules}}</view>
    </view>
    <view class="section signup-form">
      <view class="form-title">报名表单</view>
      <input placeholder="姓名" value="{{form.name}}" data-field="name" bindinput="onInput" />
      <input placeholder="手机号" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
      <input placeholder="队伍/昵称（可选）" value="{{form.team}}" data-field="team" bindinput="onInput" />
      <textarea placeholder="备注（可选）" value="{{form.note}}" data-field="note" bindinput="onInput"></textarea>
      <view class="btn-row section">
        <button type="primary" bindtap="submitForm">提交报名</button>
        <button>分享赛事</button>
      </view>
    </view>
  </view>
</view>