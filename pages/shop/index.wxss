.search-box {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f9fafb;
}

.search-box input {
  width: 100%;
}

.category-row {
  margin-top: 16rpx;
}

.goods-list {
  display: grid;
  gap: 18rpx;
  margin-top: 20rpx;
}

.goods-item {
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f9fafb;
}

.goods-title {
  font-size: 30rpx;
  font-weight: 700;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.price {
  color: #dc2626;
  font-weight: 700;
}

.tag {
  color: #f97316;
}

.stock {
  margin-top: 10rpx;
}