<view class="page">
  <view class="card">
    <view class="section-title">
      <text>资讯</text>
      <text class="muted">内容运营与活动曝光</text>
    </view>
    <view class="news-list">
      <view class="news-item" wx:for="{{newsList}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
        <view class="news-title">{{item.title}}</view>
        <view class="muted">{{item.intro}}</view>
        <view class="muted">{{item.date}}</view>
      </view>
    </view>
  </view>
</view>