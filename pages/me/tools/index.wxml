<view class="page">
  <view class="card">
    <view class="section-title">
      <text>工具中心</text>
      <text class="muted">发牌机、授权和辅助能力</text>
    </view>
    <view class="tool-list">
      <view class="tool-item" wx:for="{{tools}}" wx:key="title">
        <view class="tool-title">{{item.title}}</view>
        <view class="muted">{{item.desc}}</view>
      </view>
    </view>
  </view>
</view>