<view class="page">
  <view class="card">
    <view class="section-title">
      <text>我的赛事</text>
      <text class="muted">报名与结果记录</text>
    </view>
    <view class="record-list">
      <view class="record-item" wx:for="{{records}}" wx:key="title">
        <view class="record-title">{{item.title}}</view>
        <view class="muted">{{item.time}}</view>
        <text class="primary">{{item.status}}</text>
      </view>
    </view>
  </view>
</view>