<view class="page">
  <view class="card auth-card">
    <view class="section-title">
      <text>账号授权</text>
      <text class="muted">登录后可报名、下单和绑定设备</text>
    </view>

    <view class="auth-panel">
      <view class="panel-title">授权方式</view>
      <view class="muted">微信登录用于识别身份，手机号用于补充联系方式。</view>
      <input placeholder="手机号（可选）" value="{{phone}}" bindinput="onPhoneInput" />
      <view class="agree-row" bindtap="toggleAgree">
        <view class="check-box {{agree ? 'checked' : ''}}">{{agree ? '✓' : ''}}</view>
        <text>我已阅读并同意用户协议与隐私政策</text>
      </view>
    </view>

    <view class="btn-row section">
      <button type="primary" bindtap="loginByWechat">微信一键登录</button>
      <button bindtap="toggleAgree">切换授权勾选</button>
    </view>
  </view>
</view>